<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/CardAppPrueba"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/dp_4"
    android:layout_marginStart="@dimen/dp_4"
    android:layout_marginTop="@dimen/dp_2"
    android:layout_marginBottom="@dimen/dp_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_12">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.AppPrueba.Titulo"
            tools:text="LOS IDIOMAS CON LOS QUE APRENDIÓ A HABLAR" />

        <TextView
            android:id="@+id/tvSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:textAppearance="@style/TextAppearance.AppPrueba.Subtitulo"
            tools:text="(Lea cada alternativa y seleccione uno o más códigos)"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/layoutOpciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/dp_4">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbOpcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Opción" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutDependientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.AppPrueba.Error"
            android:visibility="gone"
            tools:text="Seleccione una opción"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>