<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/filaMarco"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingTop="@dimen/dp_4"
    android:paddingBottom="@dimen/dp_4">

    <TextView
        android:id="@+id/tvActivo"
        style="@style/TextAppearance.AppPrueba.MarcoCelda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.5"
        tools:text="1" />

    <TextView
        android:id="@+id/tvConglomerado"
        style="@style/TextAppearance.AppPrueba.MarcoCelda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        tools:text="016335" />

    <TextView
        android:id="@+id/tvNumero"
        style="@style/TextAppearance.AppPrueba.MarcoCelda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.5"
        tools:text="001" />

    <TextView
        android:id="@+id/tvSeleccion"
        style="@style/TextAppearance.AppPrueba.MarcoCelda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:text="1" />

    <TextView
        android:id="@+id/tvHogar"
        style="@style/TextAppearance.AppPrueba.MarcoCelda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:text="1" />

    <TextView
        android:id="@+id/tvReemplazo"
        style="@style/TextAppearance.AppPrueba.MarcoCelda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        tools:text="002" />

    <TextView
        android:id="@+id/tvResultado"
        style="@style/TextAppearance.AppPrueba.MarcoCelda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        tools:text="COMPLETA" />

    <ImageButton
        android:id="@+id/btnDetalle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/marco_detalle_descripcion"
        android:src="@drawable/ic_info"
        app:tint="?attr/colorPrimary" />
</LinearLayout>
