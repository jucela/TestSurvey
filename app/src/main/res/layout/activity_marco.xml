<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".presentation.activities.MarcoActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_login_arrow" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="@color/marcoBackgroundColor">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dp_10">
            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/marco_titulo"
                android:textAppearance="@style/TextAppearance.AppPrueba.Titulo"
                android:visibility="gone"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.card.MaterialCardView
                style="@style/CardAppPrueba"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/marco_titulo"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textAlignment="center"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            android:textSize="@dimen/sp_20"/>

                        <ImageButton
                            android:id="@+id/btnExpandir"
                            android:layout_width="@dimen/dp_48"
                            android:layout_height="@dimen/dp_48"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/marco_filtros_titulo"
                            android:src="@drawable/ic_expand_more"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/contenidoFiltros"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilBusqueda"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="@string/marco_busqueda_hint"
                                app:startIconDrawable="@drawable/ic_search"
                                app:endIconMode="clear_text"
                                app:endIconTint="?attr/colorOnSurfaceVariant">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etBusqueda"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/marco_busqueda_descripcion"
                                    android:imeOptions="actionSearch"
                                    android:inputType="number"
                                    android:maxLength="6"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchActivos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dp_12"
                                android:minHeight="@dimen/dp_48"
                                android:text="@string/marco_switch_activos" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilOdei"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="@string/marco_odei">

                                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                    android:id="@+id/spOdei"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:importantForAutofill="no"
                                    android:inputType="none" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilMes"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dp_8"
                                android:layout_weight="1"
                                android:hint="@string/marco_mes">

                                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                    android:id="@+id/spMes"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:importantForAutofill="no"
                                    android:inputType="none" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilPeriodo"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="@string/marco_periodo">

                                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                    android:id="@+id/spPeriodo"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:importantForAutofill="no"
                                    android:inputType="none" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilConglomerado"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dp_8"
                                android:layout_weight="1"
                                android:hint="@string/marco_conglomerado">

                                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                    android:id="@+id/spConglomerado"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:importantForAutofill="no"
                                    android:inputType="none" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <GridLayout
                android:id="@+id/gridIndicadores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:columnCount="@integer/marco_indicadores_columnas"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/dp_4"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/marco_indicador_estrato"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvEstrato"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/marco_valor_vacio"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/dp_4"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/marco_indicador_tipo"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvTipo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/marco_valor_vacio"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/dp_4"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/marco_indicador_viviendas"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvViviendas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Seleccionadas: 12  Reemplazos: 3" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/dp_4"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/marco_indicador_conglomerados"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvConglomerados"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/marco_valor_vacio"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="1" />
                </LinearLayout>
            </GridLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressCarga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:layout_gravity="center_horizontal"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/outline_info_black_24dp"
                app:drawableTint="?attr/colorOnSurfaceVariant"
                android:drawablePadding="@dimen/dp_4"
                tools:text="@string/marco_vacio_muestra"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReintentar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dp_12"
                android:text="@string/marco_reintentar"
                android:visibility="gone" />

            <HorizontalScrollView
                android:id="@+id/scrollTabla"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:layout_marginTop="@dimen/dp_8">

                <LinearLayout
                    android:id="@+id/tablaMarco"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/CardHeaders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/dp_2">

                        <LinearLayout
                        android:id="@+id/cabeceraMarco"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/primary"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/dp_8"
                        android:paddingBottom="@dimen/dp_8">

                        <TextView
                            android:id="@+id/tvCabeceraActivo"
                            style="@style/TextAppearance.AppPrueba.MarcoCabecera"
                            android:layout_width="@dimen/marco_col_activo_ancho"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:text="@string/marco_col_activo"
                            android:textColor="@color/surface"
                            android:textSize="@dimen/sp_11"/>

                        <TextView
                            android:id="@+id/tvCabeceraConglomerado"
                            style="@style/TextAppearance.AppPrueba.MarcoCabecera"
                            android:layout_width="@dimen/marco_col_conglomerado_ancho"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:text="@string/marco_col_conglomerado"
                            android:textColor="@color/surface"
                            android:textSize="@dimen/sp_11"/>

                        <TextView
                            android:id="@+id/tvCabeceraNumero"
                            style="@style/TextAppearance.AppPrueba.MarcoCabecera"
                            android:layout_width="@dimen/marco_col_numero_ancho"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:textColor="@color/surface"
                            android:text="@string/marco_col_numero" />

                        <TextView
                            android:id="@+id/tvCabeceraSeleccion"
                            style="@style/TextAppearance.AppPrueba.MarcoCabecera"
                            android:layout_width="@dimen/marco_col_seleccion_ancho"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:text="@string/marco_col_seleccion"
                            android:textColor="@color/surface"
                            android:textSize="@dimen/sp_11"/>

                        <TextView
                            android:id="@+id/tvCabeceraHogar"
                            style="@style/TextAppearance.AppPrueba.MarcoCabecera"
                            android:layout_width="@dimen/marco_col_hogar_ancho"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:text="@string/marco_col_hogar"
                            android:textColor="@color/surface"
                            android:textSize="@dimen/sp_11"/>

                        <TextView
                            android:id="@+id/tvCabeceraReemplazo"
                            style="@style/TextAppearance.AppPrueba.MarcoCabecera"
                            android:layout_width="@dimen/marco_col_reemplazo_ancho"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:text="@string/marco_col_reemplazo"
                            android:textColor="@color/surface"
                            android:textSize="@dimen/sp_11"/>

                        <TextView
                            android:id="@+id/tvCabeceraResultado"
                            style="@style/TextAppearance.AppPrueba.MarcoCabecera"
                            android:layout_width="@dimen/marco_col_resultado_ancho"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:textColor="@color/surface"
                            android:text="@string/marco_col_resultado" />

                        <TextView
                            android:id="@+id/tvCabeceraDetalle"
                            style="@style/TextAppearance.AppPrueba.MarcoCabecera"
                            android:layout_width="@dimen/marco_col_accion_ancho"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:textColor="@color/surface"
                            android:text="@string/marco_col_detalle" />

                        <TextView
                            android:id="@+id/tvCabeceraAperturar"
                            style="@style/TextAppearance.AppPrueba.MarcoCabecera"
                            android:layout_width="@dimen/marco_col_accion_ancho"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:text="@string/marco_col_aperturar"
                            android:textColor="@color/surface"
                            android:textSize="@dimen/sp_11"/>

                        <TextView
                            android:id="@+id/tvCabeceraExportar"
                            style="@style/TextAppearance.AppPrueba.MarcoCabecera"
                            android:layout_width="@dimen/marco_col_accion_ancho"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:textColor="@color/surface"
                            android:text="@string/marco_col_exportar" />

                        <TextView
                            android:id="@+id/tvCabeceraAccion"
                            style="@style/TextAppearance.AppPrueba.MarcoCabecera"
                            android:layout_width="@dimen/marco_col_accion_ancho"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:textColor="@color/surface"
                            android:text="@string/marco_col_accion" />
                    </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <gob.inei.appprueba.presentation.widget.MarcoRecyclerView
                        android:id="@+id/rvMarco"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/marco_tabla_alto_minimo"
                        android:nestedScrollingEnabled="true"
                        android:scrollbars="vertical"
                        tools:itemCount="10"
                        tools:listitem="@layout/item_marco_fila" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
